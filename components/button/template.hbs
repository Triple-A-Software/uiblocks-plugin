<div class="sc-block sc-btnblk sc-btnblk--{{ properties.align }}{{#if properties.accent}} sc-accent-{{ properties.accent }}{{/if}}" data-sc-theme="{{ properties.theme }}">
    <div class="sc-container">
        <a class="sc-btn sc-btn--{{ properties.variant }} sc-btn--{{ properties.size }}" href="{{ properties.href }}">{{ properties.label }}</a>
    </div>
</div>

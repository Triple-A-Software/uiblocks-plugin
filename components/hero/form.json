{
    "$schema": "https://neleto.io/schemas/main/form_schema.json",
    "label": { "de": "Hero", "en": "Hero" },
    "properties": [
        { "id": "eyebrow", "type": "textarea", "label": { "de": "Kleiner Titel", "en": "Eyebrow" } },
        { "id": "heading", "type": "textarea", "defaultValue": "Build faster with UI Blocks", "label": { "de": "Überschrift", "en": "Heading" } },
        { "id": "subtext", "type": "textarea", "label": { "de": "Untertext", "en": "Sub text" } },
        { "id": "primaryLabel", "type": "textarea", "defaultValue": "Get started", "label": { "de": "Button 1 Text", "en": "Primary button" } },
        { "id": "primaryHref", "type": "text", "defaultValue": "/", "label": { "de": "Button 1 Link", "en": "Primary link" } },
        { "id": "secondaryLabel", "type": "textarea", "label": { "de": "Button 2 Text", "en": "Secondary button" } },
        { "id": "secondaryHref", "type": "text", "defaultValue": "/", "label": { "de": "Button 2 Link", "en": "Secondary link" } },
        { "id": "image", "type": "relation", "relationName": "file", "label": { "de": "Bild", "en": "Image" }, "hint": { "de": "Optionales Bild für das geteilte Layout.", "en": "Optional image for the split layout." } },
        { "id": "layout", "type": "buttongroup", "defaultValue": "split",
          "options": [ { "value": "split", "label": { "de": "Geteilt", "en": "Split" } }, { "value": "center", "label": { "de": "Zentriert", "en": "Centered" } } ],
          "label": { "de": "Layout", "en": "Layout" } },
        { "id": "surface", "type": "buttongroup", "defaultValue": "default",
          "options": [ { "value": "default", "label": { "de": "Standard", "en": "Default" } }, { "value": "muted", "label": { "de": "Gedämpft", "en": "Muted" } } ],
          "label": { "de": "Hintergrund", "en": "Surface" } },
        { "id": "theme", "type": "buttongroup", "defaultValue": "auto",
          "options": [ { "value": "auto", "label": { "de": "Auto", "en": "Auto" } }, { "value": "light", "label": { "de": "Hell", "en": "Light" } }, { "value": "dark", "label": { "de": "Dunkel", "en": "Dark" } } ],
          "label": { "de": "Farbschema", "en": "Theme" } },
        { "id": "accent", "type": "select", "dataType": "string", "defaultValue": "",
          "options": [ { "value": "", "label": { "de": "Neutral", "en": "Neutral" } }, { "value": "blue", "label": { "de": "Blau", "en": "Blue" } }, { "value": "green", "label": { "de": "Grün", "en": "Green" } }, { "value": "violet", "label": { "de": "Violett", "en": "Violet" } }, { "value": "rose", "label": { "de": "Rosé", "en": "Rose" } }, { "value": "amber", "label": { "de": "Bernstein", "en": "Amber" } } ],
          "label": { "de": "Akzent", "en": "Accent" } }
    ]
}

{
    "$schema": "https://neleto.io/schemas/main/form_schema.json",
    "label": { "de": "Section", "en": "Section" },
    "properties": [
        { "id": "anchorId", "type": "text", "label": { "de": "Anker-ID", "en": "Anchor ID" }, "hint": { "de": "Wird zur HTML-id des Abschnitts (z. B. \"preise\" → #preise).", "en": "Becomes the section's HTML id (e.g. \"pricing\" → #pricing)." } },
        { "id": "cssClass", "type": "text", "label": { "de": "Zusätzliche CSS-Klassen", "en": "Extra CSS classes" }, "hint": { "de": "Optional, durch Leerzeichen getrennt.", "en": "Optional, space-separated." } },
        { "id": "surface", "type": "buttongroup", "defaultValue": "default",
          "options": [ { "value": "default", "label": { "de": "Standard", "en": "Default" } }, { "value": "muted", "label": { "de": "Gedämpft", "en": "Muted" } }, { "value": "card", "label": { "de": "Karte", "en": "Card" } } ],
          "label": { "de": "Hintergrund", "en": "Surface" } },
        { "id": "width", "type": "buttongroup", "defaultValue": "full",
          "options": [ { "value": "full", "label": { "de": "Breit", "en": "Wide" } }, { "value": "contained", "label": { "de": "Schmal", "en": "Narrow" } } ],
          "label": { "de": "Inhaltsbreite", "en": "Content width" } },
        { "id": "padding", "type": "buttongroup", "defaultValue": "md",
          "options": [ { "value": "sm", "label": { "de": "Klein", "en": "Small" } }, { "value": "md", "label": { "de": "Mittel", "en": "Medium" } }, { "value": "lg", "label": { "de": "Groß", "en": "Large" } } ],
          "label": { "de": "Abstand", "en": "Padding" } },
        { "id": "theme", "type": "buttongroup", "defaultValue": "auto",
          "options": [ { "value": "auto", "label": { "de": "Auto", "en": "Auto" } }, { "value": "light", "label": { "de": "Hell", "en": "Light" } }, { "value": "dark", "label": { "de": "Dunkel", "en": "Dark" } } ],
          "label": { "de": "Farbschema", "en": "Theme" } },
        { "id": "accent", "type": "select", "dataType": "string", "defaultValue": "",
          "options": [ { "value": "", "label": { "de": "Neutral", "en": "Neutral" } }, { "value": "blue", "label": { "de": "Blau", "en": "Blue" } }, { "value": "green", "label": { "de": "Grün", "en": "Green" } }, { "value": "violet", "label": { "de": "Violett", "en": "Violet" } }, { "value": "rose", "label": { "de": "Rosé", "en": "Rose" } }, { "value": "amber", "label": { "de": "Bernstein", "en": "Amber" } } ],
          "label": { "de": "Akzent", "en": "Accent" } }
    ]
}
